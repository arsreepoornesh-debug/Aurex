generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         String     @default("RECEPTIONIST") // OWNER, MANAGER, RECEPTIONIST, SPECIALIST, CLIENT
  phone        String?
  active       Boolean    @default(true)
  specialistId String?
  clientId     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  
  // Relations
  notes        Note[]
  followUps    FollowUp[]
  attendances  Attendance[]
  auditLogs    AuditLog[]
}

model Specialist {
  id             String       @id @default(cuid())
  name           String
  email          String       @unique
  phone          String?
  specialization String
  bio            String?
  active         Boolean      @default(true)
  colorCode      String       @default("#10B981") // HEX color for calendar/dashboard
  userId         String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  clients        Client[]
  sessions       Session[]
  assessments    Assessment[]
}

model Client {
  id                    String          @id @default(cuid())
  clientId              String          @unique // e.g. AUR-2026-0001
  name                  String
  phone                 String
  email                 String?
  dob                   DateTime?
  gender                String?         // Male, Female, Other
  address               String?
  emergencyContact      String?
  emergencyContactName  String?
  emergencyPhone        String?
  emergencyContactPhone String?
  registrationDate      DateTime        @default(now())
  referralSource        String          @default("Walk-in") // Instagram, Facebook, WhatsApp, Website, Google, Referral, Walk-in, Other
  status                String          @default("ACTIVE") // LEAD, CONSULTATION, ASSESSMENT_BOOKED, ACTIVE, INACTIVE, ON_HOLD, EXPIRED, COMPLETED
  assignedSpecialistId  String?
  assignedSpecialist    Specialist?     @relation(fields: [assignedSpecialistId], references: [id])
  photo                 String?
  userId                String?         @unique
  isDeleted             Boolean         @default(false)
  deletedAt             DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Relations
  packages              ClientPackage[]
  bookings              Booking[]
  attendances           Attendance[]
  payments              Payment[]
  assessments           Assessment[]
  notes                 Note[]
  followUps             FollowUp[]
  documents             Document[]
  consents              Consent[]
  packageFreezes        PackageFreeze[]
  notifications         Notification[]
}

model Package {
  id           String          @id @default(cuid())
  name         String
  serviceType  String          @default("SEMI_PRIVATE") // SEMI_PRIVATE, PREMIUM, ASSESSMENT, CONSULTATION
  sessionCount Int             @default(12)
  price        Float           @default(0.0)
  validityDays Int             @default(60)
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  clientPackages ClientPackage[]
}

model ClientPackage {
  id                String          @id @default(cuid())
  clientId          String
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  packageId         String?
  package           Package?        @relation(fields: [packageId], references: [id])
  name              String
  serviceType       String          @default("SEMI_PRIVATE") // SEMI_PRIVATE, PREMIUM, ASSESSMENT, CONSULTATION
  totalSessions     Int             @default(12)
  sessionsUsed      Int             @default(0)
  sessionsRemaining Int             @default(12)
  packageAmount     Float           @default(0.0)
  amountPaid        Float           @default(0.0)
  pricePaid         Float           @default(0.0)
  balanceRemaining  Float           @default(0.0)
  startDate         DateTime        @default(now())
  expiryDate        DateTime
  status            String          @default("ACTIVE") // ACTIVE, EXPIRED, COMPLETED, ON_HOLD, FROZEN
  freezeStartDate   DateTime?
  freezeEndDate     DateTime?
  freezeReason      String?
  expiryAdjustment  Int             @default(0) // Days added due to freeze
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  bookings          Booking[]
  payments          Payment[]
  packageFreezes    PackageFreeze[]
}

model Session {
  id              String       @id @default(cuid())
  title           String
  date            DateTime     // Date of the session
  startTime       String       // e.g. "08:00"
  endTime         String       // e.g. "09:00"
  serviceType     String       @default("SEMI_PRIVATE") // SEMI_PRIVATE (max 4), PREMIUM (max 1), ASSESSMENT (1), CONSULTATION (1)
  specialistId    String
  specialist      Specialist   @relation(fields: [specialistId], references: [id])
  maxCapacity     Int          @default(4)
  currentCapacity Int          @default(0)
  status          String       @default("CONFIRMED") // CONFIRMED, CANCELLED, RESCHEDULED, COMPLETED
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  bookings        Booking[]
  attendances     Attendance[]
}

model Booking {
  id              String         @id @default(cuid())
  sessionId       String
  session         Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientPackageId String?
  clientPackage   ClientPackage? @relation(fields: [clientPackageId], references: [id])
  status          String         @default("CONFIRMED") // CONFIRMED, CANCELLED, RESCHEDULED, COMPLETED
  bookedAt        DateTime       @default(now())
  bookedByUserId  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  attendances     Attendance[]

  @@unique([sessionId, clientId])
}

model Attendance {
  id              String    @id @default(cuid())
  bookingId       String?
  booking         Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  sessionId       String
  session         Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status          String    @default("PENDING") // PENDING, PRESENT, ABSENT, CANCELLED, RESCHEDULED, NO_SHOW
  markedAt        DateTime  @default(now())
  markedByUserId  String?
  markedByUser    User?     @relation(fields: [markedByUserId], references: [id])
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Payment {
  id               String         @id @default(cuid())
  clientId         String
  client           Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientPackageId  String?
  clientPackage    ClientPackage? @relation(fields: [clientPackageId], references: [id])
  packageAmount    Float          @default(0.0)
  amountPaid       Float          @default(0.0)
  amount           Float          @default(0.0)
  balanceRemaining Float          @default(0.0)
  paymentDate      DateTime       @default(now())
  paymentMethod    String         @default("UPI") // UPI, BANK_TRANSFER, CARD, CASH
  invoiceNumber    String         @unique // e.g. INV-AUR-2026-0001
  status           String         @default("PAID") // PAID, PARTIAL, PENDING, REFUNDED
  notes            String?
  isRefund         Boolean        @default(false)
  refundReason     String?
  createdByUserId  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Assessment {
  id                 String      @id @default(cuid())
  clientId           String
  client             Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  specialistId       String?
  specialist         Specialist? @relation(fields: [specialistId], references: [id])
  type               String      @default("INITIAL") // INITIAL, REASSESSMENT, PROGRESS_REVIEW
  assessmentDate     DateTime    @default(now())
  date               DateTime    @default(now())
  
  // Structured Clinical Sections (stored as JSON string)
  healthScreening    String?     // PAR-Q, red flags, physician clearance
  medicalHistory     String?     // Past injuries, spine/joints, surgeries, medications
  goals              String?     // Rehab, posture, strength, endurance, metabolic
  baselineMetrics    String?     // Height, weight, BMI, BP, resting HR, body fat %, waist/hip
  functionalMovement String?     // FMS, mobility tests, posture, core stability
  strengthAssessment String?     // McGill Big 3 (curl-up, side bridge, bird-dog), grip strength, push/pull
  cardioStrength     String?     // Legacy / summary field
  cardiovascularData String?     // Submax cardio, VO2 max estimate, resting HR, fitness category
  clinicalNotes      String?     // Specialist findings, exercise prescription, precautions
  
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model Lead {
  id                String      @id @default(cuid())
  firstName         String?
  lastName          String?
  name              String
  phone             String
  email             String?
  alternatePhone    String?
  gender            String?     @default("Male")
  dob               DateTime?
  stage             String      @default("NEW_LEAD") // NEW_LEAD, CONTACTED, CONSULTATION, ASSESSMENT_BOOKED, ASSESSMENT_COMPLETED, PACKAGE_OFFERED, JOINED, ACTIVE, RENEWAL, LOST
  source            String      @default("Instagram") // INSTAGRAM, FACEBOOK, WHATSAPP, WEBSITE, GOOGLE, REFERRAL, WALK_IN, OTHER
  convertibility    String?     @default("Warm") // HOT, WARM, COLD
  service           String?     @default("AUREX")
  trialDate         DateTime?
  scheduleFollowUp  DateTime?
  attendedBy        String?     @default("Admin")
  response          String?     // Quick response tag e.g. "Call not picked", "Timing issue"
  responseNote      String?
  notes             String?
  assignedToUserId  String?
  convertedClientId String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  followUps         FollowUp[]
}

model FollowUp {
  id             String    @id @default(cuid())
  leadId         String?
  lead           Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type           String    @default("CALL") // CALL, WHATSAPP, EMAIL, IN_PERSON
  notes          String
  followUpDate   DateTime  @default(now())
  completed      Boolean   @default(false)
  completedAt    DateTime?
  loggedByUserId String?
  loggedByUser   User?     @relation(fields: [loggedByUserId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  content   String
  category  String   @default("GENERAL") // CLINICAL, BILLING, GENERAL, PROGRESS
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id               String   @id @default(cuid())
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type             String   @default("MEDICAL_CLEARANCE") // MEDICAL_CLEARANCE, REFERRAL, CONSENT_FORM, PAR_Q, OTHER
  fileName         String
  filePath         String
  fileSize         Int      @default(0) // bytes
  uploadedAt       DateTime @default(now())
  uploadedByUserId String?
  accessPermission String   @default("STAFF_ONLY") // STAFF_ONLY, OWNER_ONLY
  notes            String?
  createdAt        DateTime @default(now())
}

model Consent {
  id               String    @id @default(cuid())
  clientId         String
  client           Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  consentVersion   String    @default("v1.0")
  consentText      String
  status           String    @default("SIGNED") // PENDING, ACKNOWLEDGED, SIGNED
  acknowledgedAt   DateTime  @default(now())
  acknowledgedBy   String?   // Staff who witnessed
  ipAddress        String?
  digitalSignature String?   // Base64 signature image or vector string
  createdAt        DateTime  @default(now())
}

model PackageFreeze {
  id               String        @id @default(cuid())
  clientPackageId  String
  clientPackage    ClientPackage @relation(fields: [clientPackageId], references: [id], onDelete: Cascade)
  clientId         String
  client           Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  freezeStartDate  DateTime
  freezeEndDate    DateTime?
  reason           String?
  daysAdded        Int           @default(0)
  status           String        @default("ACTIVE") // ACTIVE, LIFTED
  approvedByUserId String?
  createdAt        DateTime      @default(now())
}

model Expense {
  id             String    @id @default(cuid())
  date           DateTime  @default(now())
  description    String
  amount         Float     @default(0.0)
  category       String    @default("OPERATIONAL") // OPERATIONAL, EQUIPMENT, SALARIES, MAINTENANCE, UTILITIES, MARKETING, OTHER
  loggedByUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // e.g. "COMPLETE_SESSION", "RECORD_PAYMENT", "FREEZE_PACKAGE"
  entity    String   // e.g. "Session", "Payment", "Client"
  entityId  String?
  details   String?  // JSON or text describing changes
  ipAddress String?
  createdAt DateTime @default(now())
}

model Notification {
  id          String    @id @default(cuid())
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type        String    // BOOKING_CONFIRMATION, SESSION_REMINDER, EXPIRY_ALERT, RENEWAL_REMINDER
  message     String
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  status      String    @default("SENT") // PENDING, SENT, FAILED
  channel     String    @default("EMAIL") // EMAIL, SMS, WHATSAPP
  createdAt   DateTime  @default(now())
}
